{
  "name": "recipe-book-nest",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS port of the RecipeBook GraphQL backend (same API shape as recipe-book-java)",
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "schema:export": "node scripts/export-schema.mjs",
    "schema:diff": "node scripts/diff-schema.mjs",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.2.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/graphql": "^14.2.0",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/typeorm": "^12.0.3",
    "express-session": "^1.19.0",
    "graphql": "^16.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sql.js": "^1.16.0",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3"
  }
}
